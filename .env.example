# GEMINI_API_KEY: Required for Gemini AI API calls.
# En Vercel: Configurar en Settings > Environment Variables como GEMINI_API_KEY
# En AI Studio: Se inyecta automáticamente desde el panel de Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (opcional en Vercel, proveído automáticamente).
APP_URL="MY_APP_URL"
